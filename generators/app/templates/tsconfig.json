{
  "compilerOptions": {
      "lib": [
          "es7",
          "esnext.asynciterable"
      ],
      "target": "es6",
      "moduleResolution": "Node",
      "module": "commonjs",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "noUnusedLocals": true,
      "noUnusedParameters": false,
      "outDir": "dist",
      "preserveConstEnums": true,
      "sourceMap": true,
      "removeComments": true,
      "skipLibCheck": true
  },
  "include": [
      "src/**/*"
  ],
  "exclude": [
      "dist",
      "node_modules",
      "src/**/*.test.ts"
  ]
}
